{
  "name": "rpg-game",
  "version": "1.0.0",
  "description": "RPG game project with modern JS tooling",
  "keywords": [
    "rpg",
    "game",
    "javascript",
    "es6"
  ],
  "homepage": "https://github.com/babmintot/rpg-game#readme",
  "bugs": {
    "url": "https://github.com/babmintot/rpg-game/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/babmintot/rpg-game.git"
  },
  "license": "ISC",
  "author": "Valery",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "core-js": "^3.49.0",
    "pkg": "^5.8.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@eslint/js": "^10.0.1",
    "ajv": "^8.20.0",
    "ajv-keywords": "^5.1.0",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.4",
    "eslint": "^10.2.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "globals": "^17.5.0",
    "html-webpack-plugin": "^5.6.7",
    "jest": "^30.3.0",
    "mini-css-extract-plugin": "^2.10.2",
    "style-loader": "^4.0.0",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [ "<rootDir>/tests" ],
    "testMatch": [ "**/*.test.js" ],
    "collectCoverageFrom": [
      "src/js/weapons/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "transform": {
      "^.+\\.js$": "babel-jest"
    }
  }
}
